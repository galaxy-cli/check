#!/bin/bash
#
#     ___| |__   ___  ___| | __
#    / __| '_ \ / _ \/ __| |/ /
#   | (__| | | |  __/ (__|   <
#    \___|_| |_|\___|\___|_|\_\
#
# check - Quickly spell-check and correct text from the terminal with aspell
#
# Project: https://github.com/galaxy-cli/check

# --- PROGRAM CONFIGURATION ---
PROGRAM_NAME="${0##*/}"
VERSION="1.3.0"

# --- USAGE ---
usage() {
    cat <<EOF
Usage: ${PROGRAM_NAME} [OPTION]... [FILE | TEXT]

Interactively spell-check and correct text using the aspell engine.

Mandatory arguments to long options are mandatory for short options too.
  -c, --clipboard        spell-check text directly from the system clipboard
  -f, --file=FILE        spell-check text from specified plaintext FILE
  -o, --output=DIR       also save the corrected text into DIR (auto-named)
      --help             display this help and exit
  -v, --version          output version information and exit

Examples:
  ${PROGRAM_NAME}                  Launch manual prompt input mode
  ${PROGRAM_NAME} -f document.txt  Check a specific plaintext file
  ${PROGRAM_NAME} "hello wrld"     Check a raw text string directly
  ${PROGRAM_NAME} -c               Check text currently in your clipboard
  ${PROGRAM_NAME} -f notes.txt -o ~/Documents   Check and save the result

Report bugs to: <https://github.com/galaxy-cli/check/issues>
EOF
}

# --- VERSION ---
show_version() {
    cat <<EOF
${PROGRAM_NAME} ${VERSION}
EOF
}

# --- DEPENDENCY HELPER ---
# Checked contextually, right before each capability is actually needed
# (after argument parsing, so --help/--version never trigger a dependency
# prompt), rather than every command unconditionally at startup.
check_deps() {
    local missing=()
    for cmd in "$@"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done

    if [ "${#missing[@]}" -gt 0 ]; then
        echo "${PROGRAM_NAME}: missing required dependencies: ${missing[*]}" >&2
        read -rp "Would you like to install them via apt? [Y/n] " yn
        yn=${yn:-Y}

        if [[ $yn =~ ^[Yy]$ ]]; then
            sudo apt install -y "${missing[@]}"
        else
            echo "${PROGRAM_NAME}: cannot continue without required dependencies" >&2
            exit 1
        fi
    fi
}

# --- OUTPUT NAMING HELPERS (same convention as ftts) ---
# Lowercases, collapses whitespace, keeps the first ~6 words, and strips
# anything that isn't alphanumeric -- used to build a recognizable filename
# out of clipboard/string/manual input, which has no natural name of its own.
slugify_prefix() {
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | tr -s '[:space:]' ' ' \
        | cut -d' ' -f1-6 \
        | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
        | cut -c1-50
}

# Computes the final save path inside $output_dir: the source filename for
# file input (extension preserved as-is), or a content-slug + timestamp
# with a .txt extension for clipboard/string/manual input. Auto-
# disambiguates with a numeric suffix instead of silently overwriting an
# existing file of the same name.
compute_output_path() {
    local base=""
    case "$input_source" in
        file)
            base=$(basename "$file_path")
            ;;
        *)
            local slug stamp
            slug=$(slugify_prefix "$1")
            stamp=$(date +%Y%m%d-%H%M%S)
            base="${slug:-check}_${stamp}.txt"
            ;;
    esac

    local name="${base%.*}" ext="${base##*.}"
    local candidate="${output_dir%/}/${base}"
    local n=2
    while [[ -e "$candidate" ]]; do
        candidate="${output_dir%/}/${name}_${n}.${ext}"
        ((n++))
    done
    printf '%s' "$candidate"
}

# --- INITIALIZE ---
input_source=""
file_path=""
output_dir=""
text=""

# --- ARGUMENT PARSING ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--clipboard)
            [[ -n "$input_source" ]] && { echo "${PROGRAM_NAME}: multiple input sources specified" >&2; exit 1; }
            input_source="clipboard"
            shift
            ;;
        -f|--file)
            [[ -n "$input_source" ]] && { echo "${PROGRAM_NAME}: multiple input sources specified" >&2; exit 1; }
            [[ -z "$2" || "$2" == -* ]] && { echo "${PROGRAM_NAME}: option requires an argument -- 'f'" >&2; exit 1; }
            input_source="file"
            file_path="$2"
            shift 2
            ;;
        -o|--output)
            [[ -z "$2" || "$2" == -* ]] && { echo "${PROGRAM_NAME}: option requires an argument -- 'o'" >&2; exit 1; }
            output_dir="$2"
            shift 2
            ;;
        --help)
            usage
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -*)
            echo "${PROGRAM_NAME}: unrecognized option '$1'" >&2
            echo "Try '${PROGRAM_NAME} --help' for more information" >&2
            exit 1
            ;;
        *)
            if [[ -n "$input_source" ]]; then
                echo "${PROGRAM_NAME}: extra operand '$1'" >&2
                echo "Try '${PROGRAM_NAME} --help' for more information" >&2
                exit 1
            fi

            # Treat all unflagged bare trailing text strictly as a literal text string payload
            input_source="string"
            text="$*"
            set --
            ;;
    esac
done

# --- CORE DEPENDENCIES ---
check_deps aspell
[[ "$input_source" == "clipboard" ]] && check_deps xsel
[[ "$input_source" == "file" ]] && check_deps file

# --- OUTPUT DIRECTORY VALIDATION ---
if [[ -n "$output_dir" ]]; then
    if [[ ! -d "$output_dir" ]]; then
        echo "${PROGRAM_NAME}: ${output_dir}: No such directory" >&2
        exit 1
    elif [[ ! -w "$output_dir" ]]; then
        echo "${PROGRAM_NAME}: ${output_dir}: Permission denied" >&2
        exit 1
    fi
fi

# --- INTERACTIVE WORKSPACE CONFIGURATION ---
temp=$(mktemp /tmp/check_workspace.XXXXXX)
cleanup() {
    rm -f "$temp" 2>/dev/null
}
trap 'cleanup; exit 0' SIGINT SIGTERM
trap 'cleanup' EXIT

# --- DATA EXTRACTION & COMPILATION ---
case "$input_source" in
    clipboard)
        xsel -b > "$temp" 2>/dev/null
        if [[ ! -s "$temp" ]] || ! grep -q "[^[:space:]]" "$temp"; then
            echo "${PROGRAM_NAME}: clipboard is empty" >&2
            exit 1
        fi
        echo "----- BEFORE -----"
        cat "$temp"
        echo
        ;;
    file)
        if [[ ! -e "$file_path" ]]; then
            echo "${PROGRAM_NAME}: ${file_path}: No such file or directory" >&2
            exit 1
        elif [[ ! -f "$file_path" ]]; then
            echo "${PROGRAM_NAME}: ${file_path}: Not a regular file" >&2
            exit 1
        elif [[ ! -r "$file_path" ]]; then
            echo "${PROGRAM_NAME}: ${file_path}: Permission denied" >&2
            exit 1
        elif [[ $(file -b --mime-type "$file_path") != text/* ]]; then
            echo "${PROGRAM_NAME}: ${file_path}: Not a plaintext file" >&2
            exit 1
        fi
        echo "----- BEFORE -----"
        cat "$file_path" > "$temp"
        cat "$temp"
        echo
        ;;
    string)
        if [[ -z "${text//[[:space:]]/}" ]]; then
            echo "${PROGRAM_NAME}: input text string is empty" >&2
            exit 1
        fi
        echo "----- BEFORE -----"
        echo "$text" > "$temp"
        cat "$temp"
        echo
        ;;
    "")
        echo "----- BEFORE -----"
        read -r manual_input

        if [[ -z "${manual_input//[[:space:]]/}" ]]; then
            exit 0
        fi
        echo "$manual_input" > "$temp"
        ;;
esac

# Snapshot the pre-correction text now, before aspell edits $temp in place
# -- needed below for the content-slug filename on non-file input.
pre_edit_text=$(cat "$temp")

# --- INTERACTIVE VISUAL SPELL-CHECK RUNTIME ---
aspell -c "$temp"

echo "----- AFTER ------"
cat "$temp"

# --- SAVE CORRECTED TEXT (if requested) ---
if [[ -n "$output_dir" ]]; then
    output_path=$(compute_output_path "$pre_edit_text")
    cp "$temp" "$output_path"
    echo
    echo "${PROGRAM_NAME}: saved corrected text to ${output_path}" >&2
fi
