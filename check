#!/usr/bin/env bash
#
#     ___| |__   ___  ___| | __
#    / __| '_ \ / _ \/ __| |/ /
#   | (__| | | |  __/ (__|   <
#    \___|_| |_|\___|\___|_|\_\
#
# check - Quickly spell-check and correct text from the terminal with aspell
#
# Project: https://github.com/galaxy-cli/check

set -u

readonly PROGRAM_NAME="${0##*/}"
readonly VERSION="1.4.0"

usage() {
    cat <<EOF
Usage: ${PROGRAM_NAME} [OPTION]... [TEXT]

Interactively spell-check and correct text using the aspell engine.

Mandatory arguments to long options are mandatory for short options too.
  -c, --clipboard        spell-check text directly from the system clipboard
  -f, --file=FILE        spell-check text from specified plaintext FILE
  -l, --long             use multi-line manual input mode (submit with Ctrl+D)
  -o, --output=DIR       also save the corrected text into DIR (auto-named)
      --help             display this help and exit
  -v, --version          output version information and exit

Examples:
  ${PROGRAM_NAME}                  Launch single-line manual input mode (Enter to submit)
  ${PROGRAM_NAME} -l               Launch multi-line manual input mode (Ctrl+D to submit)
  ${PROGRAM_NAME} -f document.txt  Check a specific plaintext file
  ${PROGRAM_NAME} "hello wrld"     Check a raw text string directly
  ${PROGRAM_NAME} -c               Check text currently in your clipboard
  printf "teh txt" | ${PROGRAM_NAME}    Check text piped from stdin

Report bugs to: <https://github.com/galaxy-cli/check/issues>
EOF
}

show_version() {
    printf '%s %s\n' "$PROGRAM_NAME" "$VERSION"
}

die() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$1" >&2
    exit "${2:-1}"
}

check_deps() {
    local missing=()
    local cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done

    if (( ${#missing[@]} > 0 )); then
        printf '%s: missing required dependencies: %s\n' "$PROGRAM_NAME" "${missing[*]}" >&2
        printf 'Install them with your package manager (e.g., sudo apt install %s)\n' "${missing[*]}" >&2
        exit 1
    fi
}

slugify_prefix() {
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | tr -s '[:space:]' ' ' \
        | cut -d' ' -f1-6 \
        | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
        | cut -c1-50
}

compute_output_path() {
    local input_source="$1"
    local file_path="$2"
    local output_dir="$3"
    local pre_edit_text="$4"
    local base=""

    if [[ "$input_source" == "file" ]]; then
        base=$(basename "$file_path")
    else
        local slug stamp
        slug=$(slugify_prefix "$pre_edit_text")
        stamp=$(date +%Y%m%d-%H%M%S)
        base="${slug:-check}_${stamp}.txt"
    fi

    local candidate="${output_dir%/}/${base}"
    local n=2
    while [[ -e "$candidate" ]]; do
        if [[ "$base" == *.* && "${base##*.}" != "$base" ]]; then
            local name="${base%.*}" ext="${base##*.}"
            candidate="${output_dir%/}/${name}_${n}.${ext}"
        else
            candidate="${output_dir%/}/${base}_${n}"
        fi
        ((n++))
    done

    printf '%s' "$candidate"
}

validate_output_dir() {
    local dir="$1"
    [[ -d "$dir" ]] || die "${dir}: No such directory"
    [[ -w "$dir" ]] || die "${dir}: Permission denied"
}

validate_input_file() {
    local path="$1"
    [[ -e "$path" ]] || die "${path}: No such file or directory"
    [[ -f "$path" ]] || die "${path}: Not a regular file"
    [[ -r "$path" ]] || die "${path}: Permission denied"

    local mime
    mime=$(file -b --mime-type "$path")
    case "$mime" in
        text/*|application/json|application/xml|application/x-empty) ;;
        *) die "${path}: Not a plaintext file (${mime})" ;;
    esac
}

main() {
    local input_source=""
    local file_path=""
    local output_dir=""
    local long_mode=0
    local text_parts=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--clipboard)
                [[ -n "$input_source" && "$input_source" != "clipboard" ]] && die "multiple input sources specified"
                input_source="clipboard"
                shift
                ;;
            -f|--file)
                [[ -n "$input_source" && "$input_source" != "file" ]] && die "multiple input sources specified"
                [[ $# -lt 2 || -z "${2:-}" || "$2" == -* ]] && die "option requires an argument -- 'f'"
                input_source="file"
                file_path="$2"
                shift 2
                ;;
            --file=*)
                [[ -n "$input_source" && "$input_source" != "file" ]] && die "multiple input sources specified"
                file_path="${1#*=}"
                [[ -z "$file_path" ]] && die "option requires an argument -- 'f'"
                input_source="file"
                shift
                ;;
            -l|--long)
                long_mode=1
                shift
                ;;
            -o|--output)
                [[ $# -lt 2 || -z "${2:-}" || "$2" == -* ]] && die "option requires an argument -- 'o'"
                output_dir="$2"
                shift 2
                ;;
            --output=*)
                output_dir="${1#*=}"
                [[ -z "$output_dir" ]] && die "option requires an argument -- 'o'"
                shift
                ;;
            --help)
                usage
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            --)
                shift
                while [[ $# -gt 0 ]]; do
                    [[ -n "$input_source" && "$input_source" != "string" ]] && die "extra operand '$1'"
                    input_source="string"
                    text_parts+=("$1")
                    shift
                done
                ;;
            -*)
                printf "%s: unrecognized option '%s'\n" "$PROGRAM_NAME" "$1" >&2
                printf "Try '%s --help' for more information\n" "$PROGRAM_NAME" >&2
                exit 1
                ;;
            *)
                [[ -n "$input_source" && "$input_source" != "string" ]] && die "extra operand '$1'"
                input_source="string"
                text_parts+=("$1")
                shift
                ;;
        esac
    done

    # Auto-detect piped stdin when no explicit source was passed
    if [[ -z "$input_source" && ! -t 0 ]]; then
        input_source="stdin"
    fi

    if (( long_mode == 1 )) && [[ -n "$input_source" ]]; then
        die "--long can only be used in manual input mode"
    fi

    # Check only the dependencies needed for this invocation
    local deps=(aspell)
    [[ "$input_source" == "clipboard" ]] && deps+=(xsel)
    [[ "$input_source" == "file" ]] && deps+=(file)
    check_deps "${deps[@]}"

    [[ -n "$output_dir" ]] && validate_output_dir "$output_dir"
    [[ "$input_source" == "file" ]] && validate_input_file "$file_path"

    # Workspace setup & guaranteed cleanup
    local temp
    temp=$(mktemp "${TMPDIR:-/tmp}/check_workspace.XXXXXX") || die "failed to create temporary workspace"
    # shellcheck disable=SC2064
    trap "rm -f '$temp' 2>/dev/null" EXIT INT TERM

    # Load input into temporary workspace
    case "$input_source" in
        clipboard)
            xsel -b > "$temp" 2>/dev/null
            if [[ ! -s "$temp" ]] || ! grep -q "[^[:space:]]" "$temp"; then
                die "clipboard is empty"
            fi
            printf -- '----- BEFORE -----\n'
            cat "$temp"
            printf '\n'
            ;;
        file)
            cat "$file_path" > "$temp"
            if [[ ! -s "$temp" ]] || ! grep -q "[^[:space:]]" "$temp"; then
                die "${file_path}: file is empty"
            fi
            printf -- '----- BEFORE -----\n'
            cat "$temp"
            printf '\n'
            ;;
        string)
            local text="${text_parts[*]-}"
            [[ -z "${text//[[:space:]]/}" ]] && die "input text string is empty"
            printf -- '----- BEFORE -----\n'
            printf '%s\n' "$text" > "$temp"
            cat "$temp"
            printf '\n'
            ;;
        stdin)
            cat > "$temp"
            if [[ ! -s "$temp" ]] || ! grep -q "[^[:space:]]" "$temp"; then
                die "piped input is empty"
            fi
            printf -- '----- BEFORE -----\n'
            cat "$temp"
            printf '\n'
            ;;
        "")
            printf -- '----- BEFORE -----\n'
            if (( long_mode == 1 )); then
                printf '(Enter/paste text, then press Ctrl+D to submit)\n' >&2
                local manual_input
                manual_input=$(cat)
                [[ -z "${manual_input//[[:space:]]/}" ]] && exit 0
                printf '%s\n' "$manual_input" > "$temp"
            else
                local manual_line
                IFS= read -r manual_line || exit 0
                [[ -z "${manual_line//[[:space:]]/}" ]] && exit 0
                printf '%s\n' "$manual_line" > "$temp"
            fi
            ;;
    esac

    local pre_edit_text
    pre_edit_text=$(cat "$temp")

    # Reattach interactive terminal if stdin was consumed by a pipe
    if [[ "$input_source" == "stdin" ]]; then
        [[ -r /dev/tty ]] || die "interactive terminal (/dev/tty) unavailable for piped input"
        aspell -c "$temp" </dev/tty
    else
        aspell -c "$temp"
    fi

    printf -- '----- AFTER ------\n'
    cat "$temp"

    if [[ "$input_source" == "clipboard" ]]; then
        if xsel -b -i < "$temp" 2>/dev/null; then
            printf '\n%s: updated clipboard contents\n' "$PROGRAM_NAME" >&2
        else
            printf '\n%s: warning: failed to update clipboard\n' "$PROGRAM_NAME" >&2
        fi
    fi

    if [[ -n "$output_dir" ]]; then
        local output_path
        output_path=$(compute_output_path "$input_source" "$file_path" "$output_dir" "$pre_edit_text")
        cp "$temp" "$output_path"
        printf '\n%s: saved corrected text to %s\n' "$PROGRAM_NAME" "$output_path" >&2
    fi
}

main "$@"